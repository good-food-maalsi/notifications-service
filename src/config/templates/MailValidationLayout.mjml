<mjml>
    <mj-body background-color="#F4F4F4">
        <mj-section background-color="#ffffff" background-repeat="repeat" padding-bottom="0px" padding-top="30px"
                    padding="20px 0" text-align="center">
            {{ slots:header }}
        </mj-section>

        <mj-section background-repeat="repeat" background-color="#ffffff" padding-bottom="0px" padding-top="0px"
                    padding="20px 0"
                    text-align="center">
            <mj-column>
                <mj-text>
                    Bonjour {{ content.username }} !<br><br>
                    Merci d'avoir créé un compte chez nous ! Pour valider votre compte, veuillez cliquer sur le lien
                    suivant :
                </mj-text>
                <mj-button href="http://localhost:80/auth/optin/{{ content.magicToken }}">Valider mon compte</mj-button>
            </mj-column>
        </mj-section>

        <mj-section background-color="#ffffff" background-repeat="repeat" padding="20px 0" text-align="center">
            {{ slots:footer }}
        </mj-section>
    </mj-body>
</mjml>